# Copy to .env.local for local runs (npm run dev). On Vercel, add the same three as
# Environment Variables (Project → Settings → Environment Variables → Production).

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API → service_role key (secret! server only, never in the app)
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; signs driver sign-in tokens. Create with: openssl rand -hex 32
AUTH_SECRET=
